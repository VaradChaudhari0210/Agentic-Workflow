# Source files (only ship compiled dist/)
src/
*.ts
!*.d.ts
tsconfig.json

# Tests - exclude all test files
**/__tests__/
**/*.test.ts
**/*.spec.ts
**/*.test.js
**/*.spec.js
**/*.test.d.ts
**/*.spec.d.ts
**/*.test.js.map
**/*.spec.js.map
vitest.config.ts
coverage/
.nyc_output/

# Development files
.env
.env.example
.git/
.github/
.gitignore
node_modules/

# Build files not needed in package
*.tgz
.dist/

# Phase documentation (development only)
PHASE_*.md
*_PLAN.md
*_PROGRESS.md
*_SUMMARY.md

# Development documentation (keep user-facing only)
ARCHITECTURE.md
EXTENDING.md
COMPARISON.md
AUTO_DISCOVERY.md
PLAN_CONFIRMATION.md
PROJECT_SUMMARY.md
START_HERE.md
TASK_SUMMARIES.md
INDEX.md
IMPLEMENTATION_LOG.md
GETTING_STARTED.md
CODE_PATTERNS.md
TROUBLESHOOTING.md
FAQ.md
QUICK_REFERENCE.md
ERROR_HANDLING_GUIDE.md
COMPLETE_SETUP_GUIDE.md
BEFORE_PUBLISHING.md
READY_FOR_NPM.md
PROJECT_STATUS.md

# Keep only essential docs for users
!README.md
!LICENSE
!QUICKSTART.md
!EXAMPLES.md

# Build artifacts
*.log
npm-debug.log*
.DS_Store
.vscode/
.idea/

# Scripts
scripts/
