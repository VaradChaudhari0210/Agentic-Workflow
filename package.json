{
  "name": "featureForge",
  "version": "1.0.0",
  "description": "AI-powered backend engineering agent that autonomously implements features from requirements to tested code",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "backend-agent": "dist/index.js",
    "be-agent": "dist/index.js"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE",
    "QUICKSTART.md",
    "EXAMPLES.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "agent",
    "backend",
    "coding-assistant",
    "workflow",
    "ai",
    "automation",
    "typescript",
    "nodejs",
    "anthropic",
    "claude",
    "devtools"
  ],
  "author": "Varad Chaudhari varadchaudhari04@gmail.com",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VaradChaudhari0210/FeatureForge.git"
  },
  "bugs": {
    "url": "https://github.com/VaradChaudhari0210/FeatureForge/issues"
  },
  "homepage": "https://github.com/VaradChaudhari0210/FeatureForge#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "glob": "^13.0.6",
    "ora": "^8.1.1",
    "simple-git": "^3.27.0"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
