# Anthropic API Key (required)
ANTHROPIC_API_KEY=your_api_key_here

# Model configuration
MODEL=claude-sonnet-4-20250514

# Agent configuration
MAX_IMPLEMENTATION_ATTEMPTS=3
APPROVAL_MODE=manual  # manual | auto | suggest-only

# Plan confirmation (optional)
# Set to 'true' to review implementation plan before execution
# CONFIRM_PLAN=true

# Summary generation (optional)
# Set to 'false' to skip generating task summaries
# GENERATE_SUMMARY=false

# Repository paths
TARGET_REPO_PATH=../your-backend-repo
